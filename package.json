{
  "name": "svelte-check-reporter",
  "version": "0.1.0",
  "description": "Turn svelte-check output into a GitLab Code Quality report",
  "license": "MIT",
  "author": "Faissal Rezigui (https://github.com/faissalrez)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faissalrez/svelte-check-reporter.git"
  },
  "homepage": "https://github.com/faissalrez/svelte-check-reporter#readme",
  "bugs": {
    "url": "https://github.com/faissalrez/svelte-check-reporter/issues"
  },
  "type": "module",
  "bin": {
    "svelte-check-reporter": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "svelte",
    "svelte-check",
    "gitlab",
    "code-quality"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
