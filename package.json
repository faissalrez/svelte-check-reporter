{
  "name": "svelte-check-reporter",
  "version": "0.0.0",
  "description": "Turn svelte-check output into CI reports (GitLab Code Quality, SARIF)",
  "license": "MIT",
  "author": "Faissal Rezigui (https://github.com/faissalrez)",
  "type": "module",
  "bin": {
    "svelte-check-reporter": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "svelte",
    "svelte-check",
    "gitlab",
    "code-quality",
    "sarif"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
